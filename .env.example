# Fecha y hora en que Salvador nació (ISO 8601). Tiene prioridad sobre motherhoodStartFallbackIso en src/lib/site.ts
NEXT_PUBLIC_MOTHERHOOD_START=2024-03-15T14:30:00-05:00

# URL pública del sitio (Vercel: tu dominio). Mejora Open Graph y enlaces absolutos.
NEXT_PUBLIC_SITE_URL=https://tu-dominio.vercel.app

# Contraseña para subir fotos a la galería (solo la sabe tu esposa).
# Si no se define, las subidas quedan bloqueadas.
GALLERY_UPLOAD_PASSWORD=cambia-esta-contrasena

# Token de Vercel Blob. Lo añade Vercel automáticamente al crear el store de
# Blob en el proyecto (Storage → Blob). En local: `vercel env pull`.
BLOB_READ_WRITE_TOKEN=
